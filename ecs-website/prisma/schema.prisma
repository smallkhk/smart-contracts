generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  PLAYER
  MANAGER
  STAFF
  MOD
  ADMIN
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?       @db.Text
  discordId     String?       @unique
  discordTag    String?
  role          Role          @default(PLAYER)
  accounts      Account[]
  sessions      Session[]
  team          TeamMember?
  signups       ScrimSignup[]
  createdAt     DateTime      @default(now())
}

model Team {
  id             String        @id @default(cuid())
  name           String        @unique
  tag            String        @unique
  logo           String?       @db.Text
  region         String
  captainName    String
  contactDiscord String
  status         TeamStatus    @default(PENDING)
  members        TeamMember[]
  homeResults    ScrimResult[] @relation("HomeTeam")
  awayResults    ScrimResult[] @relation("AwayTeam")
  signups        ScrimSignup[]
  createdAt      DateTime      @default(now())
}

enum TeamStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  ign       String
  role      String?
  createdAt DateTime @default(now())
}

enum ScrimStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum ScrimFormat {
  BO1
  BO3
  BO5
}

model Scrim {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  scheduledAt DateTime
  format      ScrimFormat   @default(BO3)
  maxTeams    Int           @default(16)
  rules       String?       @db.Text
  prizePool   String?
  status      ScrimStatus   @default(UPCOMING)
  result      ScrimResult?
  signups     ScrimSignup[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ScrimSignup {
  id           String       @id @default(cuid())
  scrimId      String
  scrim        Scrim        @relation(fields: [scrimId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registeredBy String
  user         User         @relation(fields: [registeredBy], references: [id])
  status       SignupStatus @default(CONFIRMED)
  createdAt    DateTime     @default(now())

  @@unique([scrimId, teamId])
}

enum SignupStatus {
  CONFIRMED
  CANCELLED
}

model ScrimResult {
  id         String   @id @default(cuid())
  scrimId    String   @unique
  scrim      Scrim    @relation(fields: [scrimId], references: [id], onDelete: Cascade)
  homeTeamId String
  homeTeam   Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String
  awayTeam   Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore  Int
  awayScore  Int
  mvp        String?
  vodUrl     String?  @db.Text
  notes      String?  @db.Text
  postedAt   DateTime @default(now())
}

model BannedPlayer {
  id         String    @id @default(cuid())
  ign        String
  discordTag String?
  reason     String    @db.Text
  bannedBy   String
  permanent  Boolean   @default(true)
  expiresAt  DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
