# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/ecs_db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Discord OAuth App (create at discord.com/developers)
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# Discord Webhook URL (optional — for auto-posting results/scrims)
# Create via: Discord Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your-webhook-id/your-webhook-token"
