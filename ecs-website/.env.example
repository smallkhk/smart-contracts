# Database (MySQL - Hostinger)
# Format: mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME
DATABASE_URL="mysql://u123456789_ecs:yourpassword@srv1234.hstgr.io:3306/u123456789_ecs"

# NextAuth
NEXTAUTH_URL="http://your-vps-ip-or-domain.com"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Discord OAuth App (create at discord.com/developers)
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# Discord Webhook URL (optional)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your-webhook-id/your-webhook-token"
