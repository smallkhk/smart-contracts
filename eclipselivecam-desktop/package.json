{
  "name": "eclipselivecam",
  "version": "1.0.0",
  "description": "EclipseLiveCam — Live AI Transformation Studio",
  "author": "EclipseLiveCam",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build-linux": "electron-builder --win --x64 --config.win.signingHashAlgorithms=[] --config.forceCodeSigning=false",
    "build-mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.eclipselivecam.app",
    "productName": "EclipseLiveCam",
    "copyright": "© 2026 EclipseLiveCam",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "EclipseLiveCam"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EclipseLiveCam",
      "include": "src/installer.nsh"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.photography"
    }
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  }
}
