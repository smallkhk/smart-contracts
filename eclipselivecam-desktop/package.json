{
  "name": "eclipselivecam",
  "version": "1.0.0",
  "description": "EclipseLiveCam — Live AI Transformation Studio",
  "author": "EclipseLiveCam",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "smallkhk",
      "repo": "smart-contracts",
      "releaseType": "release"
    },
    "appId": "com.eclipselivecam.app",
    "productName": "EclipseLiveCam",
    "copyright": "© 2026 EclipseLiveCam",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32", "arm64"]
        }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "EclipseLiveCam"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EclipseLiveCam",
      "include": "src/installer.nsh"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.photography"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64", "arm64"] },
        { "target": "deb", "arch": ["x64", "arm64"] }
      ],
      "category": "Photography"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  }
}
